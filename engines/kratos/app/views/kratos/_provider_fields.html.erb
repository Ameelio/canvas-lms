<div class="ic-Form-control">
  <%= f.label :kratos_public_url, t('Public URL'), class: 'ic-Label', for: "kratos_public_url_#{presenter.id_suffix(aac)}" %>
  <%= f.text_field :kratos_public_url, class: 'ic-Input', id: "kratos_public_url_#{presenter.id_suffix(aac)}" %>
</div>

<div class="ic-Form-control">
  <%= f.label :kratos_admin_url, t('Admin URL'), class: 'ic-Label', for: "kratos_admin_url_#{presenter.id_suffix(aac)}" %>
  <%= f.text_field :kratos_admin_url, class: 'ic-Input', id: "kratos_admin_url_#{presenter.id_suffix(aac)}" %>
</div>

<div class="ic-Form-control">
  <%= f.label :jit_provisioning, t('Just in Time Provisioning'), class: 'ic-Label', for: "jit_provisioning_#{presenter.id_suffix(aac)}" %>
  <%= f.check_box :jit_provisioning, class: 'jit_provisioning_checkbox', id: "jit_provisioning_#{presenter.id_suffix(aac)}" %>
</div>
